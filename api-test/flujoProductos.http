@baseUrl = http://localhost:3000

###############################################################################
### DEFENSA FINAL - FLUJO CRÍTICO DE PRODUCTOS, PROPIEDAD Y BAJA DE ARTESANO
### Responsable: Lucas
###
### Resumen del flujo:
###   0. Preparación del escenario (Alta y habilitación de Artesano A, Artesano B y Postulante Pendiente)
###   1. Catálogo público, paginación y errores 400 / 401
###   2. Login Artesano A, rechazos de esquema (400 artesanoId / precio) y alta de 2 productos (201)
###   3. Búsqueda por nombre, listado de recursos propios (/productos/me), actualización (PATCH) y detalle por ID (200 / 404)
###   4. Seguridad y propiedad cruzada: rechazo a artesano PENDIENTE (403) y rechazo a Artesano B sobre producto de A (404)
###   5. Eliminación de producto propio (DELETE 204) y verificación (404)
###   6. Rol Administrador: rechazo al crear producto (403), baja lógica de Artesano A (DELETE /artesanos/:id),
###      ocultamiento de productos en catálogo público, bloqueo de Artesano A inactivo (403) y Logout con token revocado (401)
###   7. Limpieza / Teardown del escenario (para poder re-ejecutar el flujo infinitas veces)
###############################################################################


### ===========================================================================
### PASO 0: PREPARACIÓN DEL ESCENARIO (Pre-requisito para las pruebas)
### 1. Se postulan los artesanos desde la web pública (quedan PENDIENTES)
### 2. El Administrador se loguea y lista la bandeja de solicitudes PENDIENTES
### 3. El Administrador aprueba a los Artesanos A y B (el C queda PENDIENTE)
### ===========================================================================

### 0.1 Registrar Artesano A (Postulación pública)
# @name registroArtesanoA
POST {{baseUrl}}/usuarios/registro
Content-Type: application/json

{
  "nombre": "Lucas",
  "apellido": "Tejedor",
  "dni": "38111222",
  "email": "lucas.tejedor@ponchodigital.com",
  "telefono": "3834111222",
  "password": "Artesano2026!",
  "localidadId": 1,
  "rubroId": 1,
  "nombre_emprendimiento": "Telares Belichos",
  "descripcion_emprendimiento": "Tejidos tradicionales en fibra de vicuña y oveja"
}

###
@usuarioAId = {{registroArtesanoA.response.body.id_usuario}}
@artesanoAId = {{registroArtesanoA.response.body.artesano.id_artesano}}
@solicitudAId = {{registroArtesanoA.response.body.solicitud.id_solicitud}}


### 0.2 Registrar Artesano B (Postulación pública)
# @name registroArtesanoB
POST {{baseUrl}}/usuarios/registro
Content-Type: application/json

{
  "nombre": "Martín",
  "apellido": "Alfarero",
  "dni": "38333444",
  "email": "martin.alfarero@ponchodigital.com",
  "telefono": "3834333444",
  "password": "Artesano2026!",
  "localidadId": 1,
  "rubroId": 2,
  "nombre_emprendimiento": "Barro Catamarqueño",
  "descripcion_emprendimiento": "Piezas de alfarería y cerámica horneada a leña"
}

###
@usuarioBId = {{registroArtesanoB.response.body.id_usuario}}
@artesanoBId = {{registroArtesanoB.response.body.artesano.id_artesano}}
@solicitudBId = {{registroArtesanoB.response.body.solicitud.id_solicitud}}


### 0.3 Registrar Artesano C (Postulación pública - Se dejará PENDIENTE para probar bloqueo 403)
# @name registroArtesanoPendiente
POST {{baseUrl}}/usuarios/registro
Content-Type: application/json

{
  "nombre": "Pedro",
  "apellido": "Postulante",
  "dni": "38555666",
  "email": "pedro.pendiente@ponchodigital.com",
  "telefono": "3834555666",
  "password": "Artesano2026!",
  "localidadId": 1,
  "rubroId": 3,
  "nombre_emprendimiento": "Maderas del Valle",
  "descripcion_emprendimiento": "Tallado artesanal en madera de algarrobo"
}

###
@usuarioPendienteId = {{registroArtesanoPendiente.response.body.id_usuario}}


### 0.4 Login del Administrador (Para revisar la bandeja y aprobar)
# @name loginAdminSetup
POST {{baseUrl}}/usuarios/login
Content-Type: application/json

{
  "email": "admin@ponchodigital.com",
  "password": "AdminPoncho2026!"
}

###
@tokenAdminSetup = {{loginAdminSetup.response.body.token}}


### 0.5 Listar solicitudes PENDIENTES (Bandeja de entrada del Administrador -> 200 OK)
GET {{baseUrl}}/solicitudes?estado_solicitud=PENDIENTE&pagina=1&limite=10
Authorization: Bearer {{tokenAdminSetup}}


### 0.6 Aprobar solicitud de Artesano A (Queda APROBADO y el artesano pasa a ACTIVO)
PATCH {{baseUrl}}/solicitudes/{{solicitudAId}}/aprobar
Authorization: Bearer {{tokenAdminSetup}}
Content-Type: application/json

{
  "observaciones_admin": "Artesano A habilitado para operar productos."
}


### 0.7 Aprobar solicitud de Artesano B (Queda APROBADO y el artesano pasa a ACTIVO)
PATCH {{baseUrl}}/solicitudes/{{solicitudBId}}/aprobar
Authorization: Bearer {{tokenAdminSetup}}
Content-Type: application/json

{
  "observaciones_admin": "Artesano B habilitado para pruebas de aislamiento."
}


### ===========================================================================
### PASO 1: CATÁLOGO PÚBLICO, PAGINACIÓN Y ERRORES INICIALES (400 / 401)
### ===========================================================================

### 1.1 Listar productos con paginación (200 OK - Acceso público sin token)
GET {{baseUrl}}/productos?pagina=1&limite=5&ordenPor=precio&direccion=asc

### 1.2 Error 400: Filtro de rango de precios invertido (precioDesde > precioHasta)
GET {{baseUrl}}/productos?precioDesde=100000&precioHasta=10000

### 1.3 Error 401: Intentar crear un producto sin estar autenticado (sin token)
POST {{baseUrl}}/productos
Content-Type: application/json

{
  "nombre_producto": "Poncho sin token",
  "precio": 90000
}


### ===========================================================================
### PASO 2: LOGIN ARTESANO A, VALIDACIONES DE ESQUEMA Y ALTA DE PRODUCTOS
### ===========================================================================

### 2.1 Loguear Artesano A habilitado (200 OK)
# @name loginArtesanoA
POST {{baseUrl}}/usuarios/login
Content-Type: application/json

{
  "email": "lucas.tejedor@ponchodigital.com",
  "password": "Artesano2026!"
}

###
@tokenArtesanoA = {{loginArtesanoA.response.body.token}}

### 2.2 Error 400 (Regla Crítica): Enviar artesanoId en el body es rechazado por Zod .strict()
### (El artesano propietario se extrae exclusivamente del token JWT, nunca del cliente)
POST {{baseUrl}}/productos
Authorization: Bearer {{tokenArtesanoA}}
Content-Type: application/json

{
  "nombre_producto": "Poncho intentando forzar artesanoId",
  "precio": 120000,
  "artesanoId": 1
}

### 2.3 Error 400: Datos inválidos en el body (nombre vacío y precio negativo)
POST {{baseUrl}}/productos
Authorization: Bearer {{tokenArtesanoA}}
Content-Type: application/json

{
  "nombre_producto": "   ",
  "precio": -500
}

### 2.4 Crear Producto 1 válido (201 Created - Asociado automáticamente a Artesano A)
# @name crearProducto1
POST {{baseUrl}}/productos
Authorization: Bearer {{tokenArtesanoA}}
Content-Type: application/json

{
  "nombre_producto": "Poncho Belicho de Vicuña",
  "precio": 180000
}

###
@producto1Id = {{crearProducto1.response.body.id_producto}}

### 2.5 Crear Producto 2 válido (201 Created - Para demostrar eliminación individual más adelante)
# @name crearProducto2
POST {{baseUrl}}/productos
Authorization: Bearer {{tokenArtesanoA}}
Content-Type: application/json

{
  "nombre_producto": "Bufanda de Lana de Oveja",
  "precio": 35000
}

###
@producto2Id = {{crearProducto2.response.body.id_producto}}


### ===========================================================================
### PASO 3: BÚSQUEDA, RECURSO PROPIO (/me), ACTUALIZACIÓN Y DETALLE POR ID
### ===========================================================================

### 3.1 Buscar en el catálogo público por nombre del producto recién creado (200 OK)
GET {{baseUrl}}/productos?nombre_producto=Belicho

### 3.2 Consultar únicamente mis propios productos (GET /productos/me -> 200 OK)
GET {{baseUrl}}/productos/me
Authorization: Bearer {{tokenArtesanoA}}

### 3.3 Actualizar Producto 1 propio (PATCH /productos/:id -> 200 OK)
PATCH {{baseUrl}}/productos/{{producto1Id}}
Authorization: Bearer {{tokenArtesanoA}}
Content-Type: application/json

{
  "nombre_producto": "Poncho Belicho de Vicuña Premium",
  "precio": 195000
}

### 3.4 Error 400 en actualización: Enviar body vacío {}
PATCH {{baseUrl}}/productos/{{producto1Id}}
Authorization: Bearer {{tokenArtesanoA}}
Content-Type: application/json

{}

### 3.5 Consultar Producto 1 por ID para verificar los cambios aplicados (200 OK)
GET {{baseUrl}}/productos/{{producto1Id}}

### 3.6 Error 404: Consultar producto con ID inexistente
GET {{baseUrl}}/productos/999999

### 3.7 Error 400: Consultar producto con ID inválido (no numérico)
GET {{baseUrl}}/productos/id-invalido


### ===========================================================================
### PASO 4: SEGURIDAD Y PROPIEDAD CRUZADA (OTROS ARTESANOS)
### ===========================================================================

### 4.1 Login de Artesano C (cuya solicitud sigue PENDIENTE)
# @name loginArtesanoPendiente
POST {{baseUrl}}/usuarios/login
Content-Type: application/json

{
  "email": "pedro.pendiente@ponchodigital.com",
  "password": "Artesano2026!"
}

###
@tokenPendiente = {{loginArtesanoPendiente.response.body.token}}

### 4.2 Error 403: Artesano no habilitado (PENDIENTE) intenta crear un producto
POST {{baseUrl}}/productos
Authorization: Bearer {{tokenPendiente}}
Content-Type: application/json

{
  "nombre_producto": "Mesa de algarrobo",
  "precio": 80000
}

### 4.3 Login de Artesano B (Habilitado, pero NO es dueño de los productos de Artesano A)
# @name loginArtesanoB
POST {{baseUrl}}/usuarios/login
Content-Type: application/json

{
  "email": "martin.alfarero@ponchodigital.com",
  "password": "Artesano2026!"
}

###
@tokenArtesanoB = {{loginArtesanoB.response.body.token}}

### 4.4 Error 404 (Propiedad del recurso): Artesano B intenta modificar el Producto 1 de Artesano A
### El filtro where verifica { id_producto, artesano: { usuarioId } } -> Prisma P2025 -> 404
PATCH {{baseUrl}}/productos/{{producto1Id}}
Authorization: Bearer {{tokenArtesanoB}}
Content-Type: application/json

{
  "precio": 1000
}

### 4.5 Error 404 (Propiedad del recurso): Artesano B intenta eliminar el Producto 1 de Artesano A
DELETE {{baseUrl}}/productos/{{producto1Id}}
Authorization: Bearer {{tokenArtesanoB}}


### ===========================================================================
### PASO 5: ELIMINACIÓN DE PRODUCTO PROPIO (ARTESANO A)
### ===========================================================================

### 5.1 Artesano A elimina su Producto 2 (204 No Content)
DELETE {{baseUrl}}/productos/{{producto2Id}}
Authorization: Bearer {{tokenArtesanoA}}

### 5.2 Verificar que el Producto 2 ya no existe (404 Not Found)
GET {{baseUrl}}/productos/{{producto2Id}}

### 5.3 Verificar que el Producto 1 de Artesano A sigue disponible en el catálogo (200 OK)
GET {{baseUrl}}/productos?artesanoId={{artesanoAId}}


### ===========================================================================
### PASO 6: ADMINISTRADOR, BAJA LÓGICA DEL ARTESANO Y REVOCACIÓN DE TOKEN
### ===========================================================================

### 6.1 Login del Administrador (200 OK)
# @name loginAdminFlujo
POST {{baseUrl}}/usuarios/login
Content-Type: application/json

{
  "email": "admin@ponchodigital.com",
  "password": "AdminPoncho2026!"
}

###
@tokenAdmin = {{loginAdminFlujo.response.body.token}}

### 6.2 Error 403 (Control de Rol): El Administrador intenta crear un producto
### (Exclusivo para rol ARTESANO habilitado)
POST {{baseUrl}}/productos
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{
  "nombre_producto": "Producto creado por Admin",
  "precio": 50000
}

### 6.3 El Administrador da de baja al Artesano A (DELETE /artesanos/:id -> 200 OK)
### Realiza baja lógica: pasa a estado INACTIVO y libera su stand si tuviera uno
DELETE {{baseUrl}}/artesanos/{{artesanoAId}}
Authorization: Bearer {{tokenAdmin}}

### 6.4 Listar productos del Artesano A en el catálogo público (200 OK -> lista vacía [])
### Como el Artesano A ahora está INACTIVO, sus productos quedan ocultos en las rutas públicas
GET {{baseUrl}}/productos?artesanoId={{artesanoAId}}

### 6.5 Verificar que el Artesano A (INACTIVO) NO perdió la propiedad de sus productos (200 OK)
### En su ruta privada GET /productos/me sigue viendo su Producto 1 intacto (baja lógica, no física)
GET {{baseUrl}}/productos/me
Authorization: Bearer {{tokenArtesanoA}}

### 6.6 Error 403: Artesano A (ahora INACTIVO) intenta publicar un nuevo producto
### Aunque conserva la propiedad de los anteriores, no puede operar (POST/PATCH/DELETE) mientras esté INACTIVO
POST {{baseUrl}}/productos
Authorization: Bearer {{tokenArtesanoA}}
Content-Type: application/json

{
  "nombre_producto": "Poncho estando inactivo",
  "precio": 110000
}

### 6.7 Desloguear al Administrador (POST /usuarios/logout -> 204 No Content)
### Registra el jti del token en la tabla TokenRevocado
POST {{baseUrl}}/usuarios/logout
Authorization: Bearer {{tokenAdmin}}

### 6.8 Error 401: Intentar reutilizar el token del Administrador luego del logout
GET {{baseUrl}}/usuarios/me
Authorization: Bearer {{tokenAdmin}}


### ===========================================================================
### PASO 7: LIMPIEZA / TEARDOWN (Opcional - Restaura la BD para re-ejecutar el flujo)
### ===========================================================================

### 7.1 Nuevo login de Admin (porque el token anterior fue revocado en el paso 6.6)
# @name loginAdminTeardown
POST {{baseUrl}}/usuarios/login
Content-Type: application/json

{
  "email": "admin@ponchodigital.com",
  "password": "AdminPoncho2026!"
}

###
@tokenAdminClean = {{loginAdminTeardown.response.body.token}}

### 7.2 Eliminar usuarios de prueba (borra en cascada solicitudes, artesanos y productos restantes)
DELETE {{baseUrl}}/usuarios/{{usuarioAId}}
Authorization: Bearer {{tokenAdminClean}}

###
DELETE {{baseUrl}}/usuarios/{{usuarioBId}}
Authorization: Bearer {{tokenAdminClean}}

###
DELETE {{baseUrl}}/usuarios/{{usuarioPendienteId}}
Authorization: Bearer {{tokenAdminClean}}
