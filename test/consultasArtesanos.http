Content-Type: application/json

{
  "nombre": "Facundo",
  "apellido": "Quiroga",
  "dni": "39123456",
  "email": "facundo.quiroga@example.com",
  "password": "Password123!",
  "telefono": "3834112233",
  "localidadId": 1,
  "rubroId": 1,
  "nombre_emprendimiento": "Tejidos del Norte",
  "descripcion_emprendimiento": "Elaboración artesanal de ponchos catamarqueños y ruanas en telar criollo"
}
