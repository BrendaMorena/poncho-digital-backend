@baseUrl = http://localhost:3000

############################################################
### 1. CREACIÓN DE STANDS (POST /stands)
############################################################

# Caso de Éxito 1: Stand con sectorId obligatorio (HTTP 201)
POST {{baseUrl}}/stands/
Content-Type: application/json

{
  "numero_stand": "A-20",
  "coordenada": {
    "lat": -28.4682,
    "lng": -65.7791
  },
  "sectorId": 1
}

###

# Caso de Éxito 2: Otro stand en sector 2 (HTTP 201)
POST {{baseUrl}}/stands/
Content-Type: application/json

{
  "numero_stand": "EXT-10",
  "coordenada": {
    "lat": -28.4715,
    "lng": -65.7820
  },
  "sectorId": 2
}

###

# Error 400: Falta el campo obligatorio sectorId
POST {{baseUrl}}/stands/
Content-Type: application/json

{
  "numero_stand": "TEST-01",
  "coordenada": {
    "lat": -28.4682,
    "lng": -65.7791
  }
}

###

# Error 400: Coordenada fuera de rango (Latitud mayor a 90)
POST {{baseUrl}}/stands/
Content-Type: application/json

{
  "numero_stand": "TEST-02",
  "coordenada": {
    "lat": 150.5,
    "lng": -65.7791
  },
  "sectorId": 1
}

###

# Error 404: Sector que no existe en la base de datos
POST {{baseUrl}}/stands/
Content-Type: application/json

{
  "numero_stand": "TEST-03",
  "coordenada": {
    "lat": -28.4682,
    "lng": -65.7791
  },
  "sectorId": 9999
}

###

# Error 409: Duplicado (Mismo numero_stand que ya existe)
POST {{baseUrl}}/stands/
Content-Type: application/json

{
  "numero_stand": "A-20",
  "coordenada": {
    "lat": -28.4682,
    "lng": -65.7791
  },
  "sectorId": 1
}

###

############################################################
### 2. CONSULTA, FILTRADO Y PAGINACIÓN DE STANDS (GET /stands)
############################################################

# ==========================================================
# A. CONSULTAS BÁSICAS Y FILTROS (HTTP 200)
# ==========================================================

# Caso 1: Obtener todos los stands (sin paginación -> paginacion: null)
GET {{baseUrl}}/stands/

###

# Caso 2: Filtrar stands por Sector 1
GET {{baseUrl}}/stands?sectorId=1

###

# Caso 3: Filtrar por Estado 'DISPONIBLE'
GET {{baseUrl}}/stands?estado=DISPONIBLE

###

# Caso 4: Filtrar por Estado 'OCUPADO'
GET {{baseUrl}}/stands?estado=OCUPADO

###

# Caso 5: Filtrar por Estado 'MANTENIMIENTO'
GET {{baseUrl}}/stands?estado=MANTENIMIENTO

###

# Caso 6: Filtro relacional por Rubro
GET {{baseUrl}}/stands?rubroId=1

###

# Caso 7: Filtros combinados (Sector 1 + Estado DISPONIBLE)
GET {{baseUrl}}/stands?sectorId=1&estado=DISPONIBLE

###

# ==========================================================
# B. PAGINACIÓN Y ORDENAMIENTO (HTTP 200 con paginacion: {...})
# ==========================================================

# Caso 8: Consulta paginada (Página 1, 5 por página)
GET {{baseUrl}}/stands?pagina=1&limite=5

###

# Caso 9: Ordenar por numero_stand descendente
GET {{baseUrl}}/stands?ordenarPor=numero_stand&direccion=desc

###

# Caso 10: Ordenar por rubro ascendente
GET {{baseUrl}}/stands?ordenarPor=rubro&direccion=asc

###

# Caso 11: Combinar Filtro + Ordenamiento + Paginación
GET {{baseUrl}}/stands?estado=DISPONIBLE&ordenarPor=numero_stand&direccion=asc&pagina=1&limite=10

###

# ==========================================================
# C. CASOS SIN COINCIDENCIAS (HTTP 200 con stands vacíos `[]`)
# ==========================================================

# Caso 12: Sector válido sin ningún stand asignado
GET {{baseUrl}}/stands?sectorId=999

###

# Caso 13: Combinación de filtros que no coincide con ningún stand
GET {{baseUrl}}/stands?sectorId=2&estado=OCUPADO

###

# ==========================================================
# D. CASOS DE ERROR DE VALIDACIÓN CON ZOD (HTTP 400 Bad Request)
# ==========================================================

# Error 400: Estado inexistente en el Enum
GET {{baseUrl}}/stands?estado=CERRADO

###

# Error 400: sectorId no numérico (letras)
GET {{baseUrl}}/stands?sectorId=central

###

# Error 400: sectorId negativo o cero (violación de .positive())
GET {{baseUrl}}/stands?sectorId=-5

###

# Error 400: rubroId decimal (violación de .int())
GET {{baseUrl}}/stands?rubroId=2.5

###

# Error 400: Página inválida (0 o negativa)
GET {{baseUrl}}/stands?pagina=0

###

# Error 400: Límite mayor al permitido (máximo 50)
GET {{baseUrl}}/stands?limite=100

###

############################################################
### 3. OBTENER STAND POR ID (GET /stands/:id)
############################################################

# Caso de Éxito: Obtener un stand existente por ID (HTTP 200)
# (Incluye sector -> pabellon y artesano -> rubro)
GET {{baseUrl}}/stands/1

###

# Error 404: Stand con ID inexistente en la BD
GET {{baseUrl}}/stands/9999

###

# Error 400: ID inválido con letras (Middleware validarStandId)
GET {{baseUrl}}/stands/abc

###

# Error 400: ID negativo o cero (Middleware validarStandId)
GET {{baseUrl}}/stands/0

###

############################################################
### 4. ACTUALIZAR STAND (PATCH /stands/:id)
############################################################

# Caso de Éxito 1: Cambiar estado a MANTENIMIENTO (HTTP 200)
# (Desvincula al artesano automáticamente si tenía uno)
PATCH {{baseUrl}}/stands/1
Content-Type: application/json

{
  "estado": "MANTENIMIENTO"
}

###

# Caso de Éxito 2: Volver a poner el stand en DISPONIBLE (HTTP 200)
PATCH {{baseUrl}}/stands/1
Content-Type: application/json

{
  "estado": "DISPONIBLE"
}

###

# Caso de Éxito 3: Actualizar únicamente coordenadas (HTTP 200)
PATCH {{baseUrl}}/stands/1
Content-Type: application/json

{
  "coordenada": {
    "lat": -28.4690,
    "lng": -65.7800
  }
}

###

# Caso de Éxito 4: Mover de sector a un sectorId válido (HTTP 200)
PATCH {{baseUrl}}/stands/1
Content-Type: application/json

{
  "sectorId": 2
}

###

# Error 400: Body vacío (debe enviar al menos un campo)
PATCH {{baseUrl}}/stands/1
Content-Type: application/json

{}

###

# Error 400: Estado no perteneciente al Enum
PATCH {{baseUrl}}/stands/1
Content-Type: application/json

{
  "estado": "ROTO"
}

###

# Error 404: SectorId inexistente al intentar actualizar
PATCH {{baseUrl}}/stands/1
Content-Type: application/json

{
  "sectorId": 9999
}

###

# Error 404: Intentar actualizar un stand que no existe en la BD
PATCH {{baseUrl}}/stands/9999
Content-Type: application/json

{
  "estado": "DISPONIBLE"
}

###

# Error 409: Cambiar numero_stand por uno que ya está en uso
PATCH {{baseUrl}}/stands/1
Content-Type: application/json

{
  "numero_stand": "EXT-10"
}

###

############################################################
### 5. ELIMINAR STAND (DELETE /stands/:id)
############################################################

# Caso de Éxito: Eliminar un stand existente (HTTP 204 No Content)
DELETE {{baseUrl}}/stands/2

###

# Verificación posterior: Comprobar que el stand ya no existe (HTTP 404)
GET {{baseUrl}}/stands/2

###

# Error 404: Intentar eliminar un stand que no existe en la BD
DELETE {{baseUrl}}/stands/9999

###

# Error 400: ID de la URL con formato inválido (letras)
DELETE {{baseUrl}}/stands/invalido

###