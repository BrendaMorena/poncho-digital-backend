# VARIABLES DE ENTORNO EXCLUSIVAS PARA PRUEBAS (TESTS DE INTEGRACIÓN)
# NUNCA usar la base de datos de desarrollo, ya que los tests limpian las tablas.

# Conexión a base de pruebas en Supabase (con ?env=test para la aserción de seguridad)
DATABASE_URL="postgresql://postgres:TU_PASSWORD@db.TU_PROYECTO_TEST.supabase.co:5432/postgres?env=test"
DIRECT_URL="postgresql://postgres:TU_PASSWORD@db.TU_PROYECTO_TEST.supabase.co:5432/postgres?env=test"


# Modo de pruebas (controla que app.listen no se inicie durante los tests)
NODE_ENV=test

JWT_SECRET=secreto-exclusivo-de-pruebas
